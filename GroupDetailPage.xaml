<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Planoria.GroupDetailPage"
             BackgroundColor="#FDF0F2">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24,30,24,20">

        <Label Grid.Row="0" x:Name="GroupNameLabel" Text="Grup" 
               FontSize="26" FontAttributes="Bold" TextColor="#F4A6C1" Margin="0,0,0,16"/>

        <!-- Görev ekleme -->
        <Frame Grid.Row="1" CornerRadius="24" Padding="6" BackgroundColor="White" 
               BorderColor="#F4C2D7" HasShadow="True" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto">
                <Entry Grid.Column="0" x:Name="NewTaskEntry" 
                       Placeholder="Gruba görev ekle..." 
                       PlaceholderColor="#C99AAB"
                       TextColor="#5A3A45"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       Margin="12,0,0,0"/>
                <Button Grid.Column="1" Text="➕" 
                        Clicked="OnAddTaskClicked"
                        BackgroundColor="#F4A6C1" TextColor="White"
                        CornerRadius="20" WidthRequest="44" HeightRequest="44" Padding="0"/>
            </Grid>
        </Frame>

        <!-- Görev listesi -->
        <CollectionView Grid.Row="2" x:Name="TasksCollectionView">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="🐾" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="henüz ortak görev yok" TextColor="#C99AAB" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="18" Padding="14,10" Margin="0,0,0,10" 
                           BackgroundColor="White" BorderColor="#F4C2D7" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" 
                                      Color="#F4A6C1" CheckedChanged="OnTaskCheckedChanged"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="4,0,0,0">
                                <Label Text="{Binding Title}" FontSize="15" TextColor="#5A3A45"/>
                               
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="🗑️" Clicked="OnDeleteTaskClicked"
                                    BackgroundColor="Transparent" FontSize="16" Padding="4"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>