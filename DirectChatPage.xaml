<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Planoria.DirectChatPage"
             BackgroundColor="#FDF0F2">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <Grid Grid.Row="0" Padding="20,30,20,12" BackgroundColor="White">
            <VerticalStackLayout Spacing="0">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="NameLabel" Text="..." FontSize="20" FontAttributes="Bold" TextColor="#D98BA8"/>
                <Label Text="profili görmek için dokun" FontSize="11" TextColor="#C99AAB"/>
            </VerticalStackLayout>
        </Grid>

        <CollectionView Grid.Row="1" x:Name="MessagesCollectionView"
                        Margin="14,10,14,0"
                        ItemTemplate="{StaticResource BubbleSelector}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="🐱" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="ilk mesajı sen yaz!" TextColor="#C99AAB" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <Label Grid.Row="2" x:Name="InfoLabel" IsVisible="False" Padding="20,8"
               FontSize="12" TextColor="#8B6B77" HorizontalTextAlignment="Center"/>

        <Grid Grid.Row="3" x:Name="RequestBar" IsVisible="False"
              ColumnDefinitions="*,*" ColumnSpacing="10" Padding="20,4,20,14">
            <Button Grid.Column="0" Text="Reddet" Clicked="OnDeclineClicked"
                    BackgroundColor="White" TextColor="#D98BA8"
                    BorderColor="#D98BA8" BorderWidth="1.5"
                    CornerRadius="20" HeightRequest="44"/>
            <Button Grid.Column="1" Text="Kabul Et" Clicked="OnAcceptClicked"
                    BackgroundColor="#D98BA8" TextColor="White"
                    FontAttributes="Bold" CornerRadius="20" HeightRequest="44"/>
        </Grid>

        <Grid Grid.Row="4" x:Name="InputBar" Padding="14,8,14,14" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Frame Grid.Column="0" CornerRadius="24" Padding="6" BackgroundColor="White"
                   BorderColor="#F4C2D7" HasShadow="False">
                <Entry x:Name="MessageEntry" Placeholder="Mesaj yaz..." MaxLength="2000"
                       PlaceholderColor="#C99AAB" TextColor="#5A3A45"
                       BackgroundColor="Transparent" Margin="10,0,0,0"
                       Completed="OnSendClicked"/>
            </Frame>
            <Button Grid.Column="1" Text="➤" Clicked="OnSendClicked"
                    BackgroundColor="#D98BA8" TextColor="White"
                    CornerRadius="24" WidthRequest="48" HeightRequest="48" Padding="0"/>
        </Grid>

    </Grid>

</ContentPage>