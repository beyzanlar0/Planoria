<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Planoria.GroupTasksPage"
             BackgroundColor="#FDF0F2"
             Title="Ortak Görevler">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,20,20,10" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Label x:Name="GroupNameLabel" Text="..." FontSize="13" TextColor="#C99AAB"/>
            <Label Text="ortak görevler" FontSize="26" FontAttributes="Bold" TextColor="#F4A6C1"/>
        </VerticalStackLayout>

        <!-- Sadece lider (Yönetici / Yardımcı yönetici) görür -->
        <VerticalStackLayout Grid.Row="1" x:Name="LeaderPanel" IsVisible="False" Spacing="10">
            <Button Text="➕ Yeni Görev" Clicked="OnToggleFormClicked"
                    BackgroundColor="#F4A6C1" TextColor="White"
                    CornerRadius="18" HeightRequest="42" FontSize="13"/>

            <Frame x:Name="NewTaskForm" IsVisible="False" CornerRadius="20" Padding="14"
                   BackgroundColor="White" BorderColor="#F4C2D7" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Entry x:Name="TitleEntry" Placeholder="Görev başlığı" MaxLength="200"
                           PlaceholderColor="#C99AAB" TextColor="#5A3A45"/>
                    <Editor x:Name="DescriptionEditor" Placeholder="Açıklama (isteğe bağlı)" MaxLength="1000"
                            PlaceholderColor="#C99AAB" TextColor="#5A3A45" HeightRequest="80"/>
                    <Picker x:Name="DurationPicker" Title="Süre seç" TextColor="#5A3A45"/>
                    <Button Text="Görevi Oluştur" Clicked="OnCreateTaskClicked"
                            BackgroundColor="#D98BA8" TextColor="White"
                            FontAttributes="Bold" CornerRadius="20" HeightRequest="44"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>

        <RefreshView Grid.Row="2" x:Name="TasksRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="TasksCollectionView">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="🐾" FontSize="36" HorizontalOptions="Center"/>
                        <Label Text="henüz ortak görev yok" TextColor="#C99AAB" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="18" Padding="14" Margin="0,0,0,12"
                               BackgroundColor="White" BorderColor="#F4C2D7" HasShadow="False">
                            <VerticalStackLayout Spacing="6">

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Title}" FontSize="16"
                                           FontAttributes="Bold" TextColor="#5A3A45" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="🗑️" Clicked="OnDeleteTaskClicked"
                                            IsVisible="{Binding CanDelete}"
                                            BackgroundColor="Transparent" FontSize="16" Padding="4"/>
                                </Grid>

                                <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                       FontSize="13" TextColor="#8B6B77"/>
                                <Label Text="{Binding DurationText, StringFormat='⏳ Süre: {0}'}"
                                       FontSize="12" TextColor="#C99AAB"/>

                                <Button Text="✋ Ben Alıyorum" Clicked="OnRequestClicked"
                                        IsVisible="{Binding CanRequest}"
                                        BackgroundColor="#F4A6C1" TextColor="White"
                                        CornerRadius="14" FontSize="12" HeightRequest="36"/>

                                <BoxView HeightRequest="1" Color="#F4C2D7" IsVisible="{Binding HasAssignments}"/>

                                <!-- Görevi alanlar + sayaçlar -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Assignments}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                                    <Label Text="{Binding DisplayName}" FontSize="13" TextColor="#5A3A45"/>
                                                    <Label Text="{Binding StatusText}" FontSize="12"
                                                           FontAttributes="Bold" TextColor="{Binding ColorHex}"/>
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Button Text="✔ Onayla" Clicked="OnApproveClicked"
                                                            IsVisible="{Binding CanApprove}"
                                                            BackgroundColor="#5BBF94" TextColor="White"
                                                            CornerRadius="12" FontSize="11" HeightRequest="30" Padding="10,0"/>
                                                    <Button Text="✖" Clicked="OnRejectClicked"
                                                            IsVisible="{Binding CanApprove}"
                                                            BackgroundColor="#E0607A" TextColor="White"
                                                            CornerRadius="12" FontSize="11" HeightRequest="30" Padding="10,0"/>
                                                    <Button Text="🏁 Bitirdim" Clicked="OnCompleteClicked"
                                                            IsVisible="{Binding CanComplete}"
                                                            BackgroundColor="#D98BA8" TextColor="White"
                                                            CornerRadius="12" FontSize="11" HeightRequest="30" Padding="10,0"/>
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>