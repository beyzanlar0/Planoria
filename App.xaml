<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Planoria"
             x:Class="Planoria.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Benim mesajım: sağda -->
            <DataTemplate x:Key="MineBubbleTemplate">
                <Grid HorizontalOptions="Fill">
                    <Frame HorizontalOptions="End" MaximumWidthRequest="280"
                           CornerRadius="18" Padding="12,8"
                           BackgroundColor="#F4A6C1" BorderColor="#F4A6C1" HasShadow="False">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Content}" FontSize="14" TextColor="White"/>
                            <Label Text="{Binding TimeText}" FontSize="10" TextColor="#FFF0F5"
                                   HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>
            </DataTemplate>

            <!-- Karşı tarafın mesajı: solda, yanında avatar -->
            <DataTemplate x:Key="OtherBubbleTemplate">
                <Grid HorizontalOptions="Fill" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Frame Grid.Column="0" CornerRadius="18" WidthRequest="36" HeightRequest="36"
                           Padding="0" HasShadow="False" VerticalOptions="End"
                           BackgroundColor="{Binding AvatarColor}" BorderColor="Transparent">
                        <Label Text="{Binding AvatarEmoji}" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Frame Grid.Column="1" HorizontalOptions="Start" MaximumWidthRequest="280"
                           CornerRadius="18" Padding="12,8"
                           BackgroundColor="White" BorderColor="#F4C2D7" HasShadow="False">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding SenderName}" IsVisible="{Binding ShowSenderName}"
                                   FontSize="11" FontAttributes="Bold" TextColor="#D98BA8"/>
                            <Label Text="{Binding Content}" FontSize="14" TextColor="#5A3A45"/>
                            <Label Text="{Binding TimeText}" FontSize="10" TextColor="#C99AAB"
                                   HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>
            </DataTemplate>

            <local:ChatBubbleSelector x:Key="BubbleSelector"
                                      MineTemplate="{StaticResource MineBubbleTemplate}"
                                      OtherTemplate="{StaticResource OtherBubbleTemplate}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>