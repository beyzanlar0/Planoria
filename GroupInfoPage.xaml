<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Planoria.GroupInfoPage"
             BackgroundColor="#FDF0F2"
             Title="Grup Bilgisi">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24,20,24,20" RowSpacing="12">

        <!-- Grup kartı -->
        <Frame Grid.Row="0" CornerRadius="20" Padding="16" BackgroundColor="White"
               BorderColor="#F4C2D7" HasShadow="True">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Frame Grid.Column="0" CornerRadius="32" WidthRequest="64" HeightRequest="64"
                       Padding="0" BackgroundColor="#F4A6C1" HasShadow="False">
                    <Label Text="👥" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="GroupNameLabel" Text="..." FontSize="18" FontAttributes="Bold" TextColor="#5A3A45"/>
                    <Label x:Name="MemberCountLabel" Text="" FontSize="13" TextColor="#C99AAB"/>
                </VerticalStackLayout>
                <Button Grid.Column="2" x:Name="EditNameButton" Text="✏️ Düzenle"
                        Clicked="OnEditNameClicked" IsVisible="False"
                        BackgroundColor="#F4A6C1" TextColor="White"
                        CornerRadius="14" FontSize="12" HeightRequest="34"
                        VerticalOptions="Center" Padding="12,0"/>
            </Grid>
        </Frame>

        <!-- Üyeler başlığı + üye ekle -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,8,0,0">
            <Label Grid.Column="0" Text="Üyeler" FontSize="16" FontAttributes="Bold"
                   TextColor="#D98BA8" VerticalOptions="Center"/>
            <Button Grid.Column="1" x:Name="AddMemberButton" Text="➕ Üye Ekle"
                    Clicked="OnAddMemberClicked" IsVisible="False"
                    BackgroundColor="White" TextColor="#D98BA8"
                    BorderColor="#F4A6C1" BorderWidth="1.5"
                    CornerRadius="14" FontSize="12" HeightRequest="34" Padding="12,0"/>
        </Grid>

        <!-- Üye listesi -->
        <CollectionView Grid.Row="2" x:Name="MembersCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="18" Padding="14,10" Margin="0,0,0,10"
                           BackgroundColor="White" BorderColor="#F4C2D7" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMemberTapped"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Frame Grid.Column="0" CornerRadius="20" WidthRequest="40" HeightRequest="40"
       Padding="0" BackgroundColor="{Binding AvatarColor}" HasShadow="False" BorderColor="Transparent">
                                <Label Text="{Binding AvatarEmoji}" FontSize="16"
           HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding DisplayName}" FontSize="15" TextColor="#5A3A45"/>
                                <Label Text="{Binding RoleText}" FontSize="12" TextColor="#C99AAB"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#C99AAB" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Gruptan ayrıl -->
        <Button Grid.Row="3" Text="Gruptan Ayrıl" Clicked="OnLeaveClicked"
                BackgroundColor="Transparent" TextColor="#D98BA8"
                BorderColor="#D98BA8" BorderWidth="1.5"
                CornerRadius="20" HeightRequest="48"/>

    </Grid>

</ContentPage>