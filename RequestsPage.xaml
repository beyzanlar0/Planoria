<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Planoria.RequestsPage"
             BackgroundColor="#FDF0F2"
             Title="İstekler">

    <Grid RowDefinitions="Auto,*" Padding="24,20,24,20">

        <Label Grid.Row="0" Text="istekler" FontSize="28" FontAttributes="Bold"
               TextColor="#F4A6C1" Margin="0,0,0,14"/>

        <CollectionView Grid.Row="1" x:Name="RequestsCollectionView">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="📭" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="bekleyen isteğin yok" TextColor="#C99AAB" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="18" Padding="14,12" Margin="0,0,0,10"
                           BackgroundColor="White" BorderColor="#F4C2D7" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRequestTapped"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Frame Grid.Column="0" CornerRadius="22" WidthRequest="44" HeightRequest="44"
       Padding="0" BackgroundColor="{Binding IconColor}" HasShadow="False" BorderColor="Transparent">
                                    <Label Text="{Binding Icon}" FontSize="18"
           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#5A3A45"/>
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#8B6B77"/>
                                </VerticalStackLayout>
                            </Grid>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <Button Text="Reddet" Clicked="OnDeclineClicked"
                                        BackgroundColor="White" TextColor="#D98BA8"
                                        BorderColor="#D98BA8" BorderWidth="1.5"
                                        CornerRadius="14" FontSize="12" HeightRequest="34" Padding="14,0"/>
                                <Button Text="Kabul Et" Clicked="OnAcceptClicked"
                                        BackgroundColor="#D98BA8" TextColor="White"
                                        CornerRadius="14" FontSize="12" HeightRequest="34" Padding="14,0"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>