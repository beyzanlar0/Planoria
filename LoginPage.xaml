<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Planoria.LoginPage"
             BackgroundColor="#FDF0F2">

    <ScrollView>
        <Grid Padding="30" RowDefinitions="Auto,Auto,*" VerticalOptions="Center">

            <Grid Grid.Row="0" Margin="0,20,0,10">
                <Label Text="🐾" FontSize="28" HorizontalOptions="Start" Margin="10,0,0,0"/>
                <Label Text="✨" FontSize="22" HorizontalOptions="End" Margin="0,0,30,0"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,30">
                <Label Text="planoria" FontSize="44" FontAttributes="Bold" 
                       TextColor="#D4A5B5" HorizontalOptions="Center" 
                       Margin="2,2,0,0"/>
                <Label Text="planoria" FontSize="44" FontAttributes="Bold" 
                       TextColor="#F4A6C1" HorizontalOptions="Center"/>
            </Grid>

            <VerticalStackLayout Grid.Row="2" Spacing="18">

                <Frame CornerRadius="30" Padding="6" BackgroundColor="White" 
                       BorderColor="#F4C2D7" HasShadow="True">
                    <Grid ColumnDefinitions="Auto,*">
                        <Frame Grid.Column="0" CornerRadius="24" WidthRequest="48" HeightRequest="48" 
                               Padding="0" BackgroundColor="#F4A6C1" HasShadow="False">
                            <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <Entry Grid.Column="1" x:Name="EmailEntry" 
                               Placeholder="Email veya kullanıcı adı" 
                               PlaceholderColor="#C99AAB"
                               TextColor="#5A3A45"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               Margin="10,0,10,0"/>
                    </Grid>
                </Frame>

                <Frame CornerRadius="30" Padding="6" BackgroundColor="White" 
                       BorderColor="#F4C2D7" HasShadow="True">
                    <Grid ColumnDefinitions="Auto,*">
                        <Frame Grid.Column="0" CornerRadius="24" WidthRequest="48" HeightRequest="48" 
                               Padding="0" BackgroundColor="#F4A6C1" HasShadow="False">
                            <Label Text="🔒" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <Entry Grid.Column="1" x:Name="PasswordEntry" 
                               Placeholder="Şifre" 
                               IsPassword="True"
                               PlaceholderColor="#C99AAB"
                               TextColor="#5A3A45"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               Margin="10,0,10,0"/>
                    </Grid>
                </Frame>

                <Label x:Name="ErrorLabel" TextColor="#E0607A" IsVisible="False" 
                       FontSize="13" HorizontalOptions="Center"/>

                <Button Text="Giriş Yap" 
                        Clicked="OnLoginClicked"
                        BackgroundColor="#D98BA8"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="28"
                        HeightRequest="56"
                        Margin="0,10,0,0"/>

                <Label HorizontalOptions="Center" Margin="0,16,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Hesabın yok mu? " TextColor="#C99AAB" FontSize="14"/>
                            <Span Text="Kayıt ol" TextColor="#D98BA8" FontAttributes="Bold" FontSize="14">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGoToRegisterTapped"/>
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>